# Copy to .env.production (or set these in Cloudflare Pages › Settings › Environment variables).

# URL of the deployed game server (Cloudflare Worker). Leave unset for an offline-only build:
# no sign-in, no holding companies, no leaderboards.
VITE_API_URL=https://cash-flow-x-api.<your-subdomain>.workers.dev

# OAuth client ID from Google Cloud (APIs & Services › Credentials › OAuth client ID › Web application).
# The same value goes in the Worker's GOOGLE_CLIENT_ID variable.
VITE_GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# Local development only: sign in by name against a Worker running with DEV_AUTH=true.
# Never set this in production.
# VITE_DEV_AUTH=true
